{
  "name": "frontend-template",
  "version": "0.1.0",
  "private": true,
  "description": "Boilerplate for Frontend application with server-side rendering and e2e and unit testing configurations",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "op run --env-file='.env' --no-masking -- next build",
    "test": "op run --env-file='.env' --no-masking -- vitest run",
    "test-coverage": "op run --env-file='.env' --no-masking -- vitest run --coverage",
    "test-watch": "op run --env-file='.env' --no-masking -- vitest",
    "test-e2e": "playwright test",
    "test-e2e-watch": "playwright test --ui",
    "start": "op run --env-file='.env' --no-masking -- next start",
    "lint": "./node_modules/.bin/eslint \"**/*.tsx\" --fix && next lint --fix && prettier --write ./ ",
    "prepare": "husky install"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@mui/icons-material": "6.4.7",
    "@mui/material": "6.4.7",
    "@mui/material-nextjs": "6.4.3",
    "@next/font": "^14.2.15",
    "@tanstack/react-query": "^5.74.11",
    "classnames": "2.5.1",
    "css-mediaquery": "0.1.2",
    "mongoose": "8.8.2",
    "next": "14.2.25",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.9.0",
    "@babel/core": "7.26.10",
    "@playwright/test": "1.42.1",
    "@testing-library/dom": "9.3.3",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "14.3.1",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.5.1",
    "@types/css-mediaquery": "0.1.2",
    "@types/fs-extra": "11.0.2",
    "@types/node": "20.12.7",
    "@types/pixelmatch": "5.2.4",
    "@types/pngjs": "6.0.1",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "1.6.0",
    "babel-loader": "9.1.3",
    "commitlint": "17.7.1",
    "conventional-changelog-conventionalcommits": "7.0.2",
    "eslint": "8.57.0",
    "eslint-plugin-oev": "0.6.0",
    "happy-dom": "13.10.1",
    "husky": "8.0.3",
    "identity-obj-proxy": "3.0.0",
    "mongodb-memory-server": "10.1.2",
    "msw": "2.2.2",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "prettier": "3.2.5",
    "pretty-quick": "3.3.1",
    "react-test-renderer": "18.2.0",
    "stylelint": "16.4.0",
    "stylelint-plugin-oev": "0.1.1",
    "ts-node": "10.9.1",
    "typescript": "5.4.5",
    "vitest": "1.6.0",
    "vitest-axe": "0.1.0"
  },
  "packageManager": "pnpm@10.4.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
